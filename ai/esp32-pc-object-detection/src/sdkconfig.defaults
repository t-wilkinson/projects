# ── Memory ──────────────────────────────────────────────────────────────────
# Enable PSRAM if your board has it (most ESP32-S3 devkits do).
# Remove or set to n if your board has no PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Grow the main task stack — Rust async + std needs more than the default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# ── WiFi ─────────────────────────────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32

# ── TCP/IP (lwIP) ────────────────────────────────────────────────────────────
# Increase the number of simultaneous TCP sockets for the WS server.
CONFIG_LWIP_MAX_SOCKETS=16

# ── HTTP server (esp_http_server) ────────────────────────────────────────────
# Maximum number of open HTTP/WebSocket connections.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y
CONFIG_HTTPD_WS_SUPPORT=y          # MUST be enabled for WebSocket support

# ── Logging ──────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Watchdog ─────────────────────────────────────────────────────────────────
# Disable the task watchdog during development so long builds don't reboot.
# Re-enable for production.
CONFIG_ESP_TASK_WDT_EN=n

# CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
