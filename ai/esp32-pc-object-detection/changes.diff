++// ─────────────────────────────────────────────────────────────────────────────
++// fomo.h — Minimal C API for the FOMO detection pipeline
++//
++// Camera init + capture + preprocess + TFLite inference + output parsing
++// all live behind these two function calls.  Rust only sees detections.
++// ─────────────────────────────────────────────────────────────────────────────
++#pragma once
++
++#include <stddef.h>
++#include <stdint.h>
++
++#ifdef __cplusplus
++extern "C" {
