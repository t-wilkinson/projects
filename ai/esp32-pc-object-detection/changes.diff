++    "# ── Model / training config ──────────────────────────────────────────────\n",
++    "INPUT_SIZE     = 96        # 96x96 pixels — fits ESP32 memory budget\n",
++    "GRID_SIZE      = 12        # INPUT_SIZE / stride(8) = 12\n",
