++                        session_id,
++                        &frame as *const _ as *mut _,
++                    );
++                }
++            }
++        }
++
++        // 7. Rate limit
++        let elapsed = t_start.elapsed();
++        let target = Duration::from_millis(INFERENCE_INTERVAL_MS);
++        if elapsed < target {
++            thread::sleep(target - elapsed);
++        }
++    }
++}
