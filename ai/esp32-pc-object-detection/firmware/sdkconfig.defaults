# Settings shared by every chip. Chip-specific settings live in
# sdkconfig.defaults.esp32s3 / sdkconfig.defaults.esp32 (esp-idf-sys picks the
# one matching $MCU automatically).

# ── CPU / RTOS ───────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 1 ms ticks so thread::sleep(Duration::from_millis(n)) means what it says.
CONFIG_FREERTOS_HZ=1000
# The main task only brings up WiFi + HTTP; inference runs on its own pinned
# thread whose stack size is set in Rust. Stacks live in internal SRAM, so
# don't make this bigger than it needs to be.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# ── PSRAM ────────────────────────────────────────────────────────────────────
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# malloc() of <= 4 KiB stays in fast internal SRAM; bigger blocks go to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Keep 32 KiB of internal SRAM back for DMA descriptors and drivers that can't
# use PSRAM.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Put WiFi/lwIP buffers in PSRAM. This frees internal SRAM that the tensor
# arena can use instead.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── WiFi ─────────────────────────────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# ── HTTP server ──────────────────────────────────────────────────────────────
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ── Speed ────────────────────────────────────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ── Logging ──────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
