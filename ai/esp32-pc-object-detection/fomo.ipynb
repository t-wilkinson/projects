    "    plt.title(\"Weighting Strategy Curves: Scarcity vs. Importance\")\n",
    "    plt.legend()\n",
    "    plt.grid(True, which=\"both\", ls=\"-\", alpha=0.2)\n",
    "    plt.show()\n",
    "\n",
    "plot_weight_curves(df_weights)"
