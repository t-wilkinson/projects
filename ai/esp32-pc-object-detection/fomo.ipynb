    "# Step 2: ONNX → TFLite with onnx2tf\n",
    "# pip install onnx2tf tensorflow\n",
    "import onnx2tf\n",
    "\n",
    "tf_path = OUTPUT_DIR / \"output_tf\"\n",
    "onnx2tf.convert(\n",
    "    input_onnx_file_path=onnx_path,\n",
    "    output_folder_path=tf_path,\n",
    "    non_verbose=True,\n",
    ")\n",
    "# This produces a SavedModel in output_tf/"
   ]
