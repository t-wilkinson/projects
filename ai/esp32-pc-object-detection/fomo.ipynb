    "    str(onnx_path),\n",
    "    opset_version=18,\n",
    "    input_names=['input'],\n",
    "    output_names=['output'],\n",
    "    dynamic_axes=None,  # Fixed batch size of 1 for MCU\n",
    ")\n",
    "\n",
    "onnx_size = onnx_path.stat().st_size / 1024\n",
    "print(f'ONNX model saved: {onnx_path} ({onnx_size:.1f} KB)')"
